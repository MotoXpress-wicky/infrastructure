# Template. Copy to the same name without .example and fill real values. The real file is ignored by git.
SPRING_PROFILES_ACTIVE=docker

# Database (its own database and DB user)
DB_URL=jdbc:postgresql://postgres:5432/user_db
POSTGRES_USER=user_service
POSTGRES_PASSWORD=change-me

# RabbitMQ (standard Spring Boot names for spring.rabbitmq.*)
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=change-me
SPRING_RABBITMQ_PASSWORD=change-me

# Names below are the ones user-service's application.yaml reads today.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
JWT_SECRET=change-me
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
TURNSTILE_SECRET_KEY=change-me
FRONTEND_URL=http://staging.example.com
FRONTEND_BASE_URL=http://staging.example.com
ALLOWED_ORIGINS=http://staging.example.com,http://admin.staging.example.com

# Object storage (S3 API). TODO: profile pictures are planned; use the real property names then.
# Keys = USER_SERVICE_ACCESS_KEY / USER_SERVICE_SECRET_KEY in object-storage.env (must match).
# Moving to AWS S3 later: remove S3_ENDPOINT, put AWS keys, the real region and the real bucket name.
S3_ENDPOINT=http://object-storage:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=user-avatars
# Store only the object key. URL sent to the browser = MEDIA_BASE_URL + "/" + key
MEDIA_BASE_URL=http://staging.example.com/media/avatars

# The first admin. At start-up, if no admin exists, this account is created (or promoted if it exists).
# Use your own address and a strong password. After the first start you may remove the password line.
ADMIN_BOOTSTRAP_EMAIL=you@your-domain.example
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-long-random-password
ADMIN_BOOTSTRAP_NAME=Administrator
