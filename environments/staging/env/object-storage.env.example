# Template. Copy to the same name without .example and fill real values. The real file is ignored by git.
# One S3 key pair per service (see object-storage/users.conf). Use long random values.
# Each pair must be the SAME as S3_ACCESS_KEY / S3_SECRET_KEY in that service's env file.
USER_SERVICE_ACCESS_KEY=change-me
USER_SERVICE_SECRET_KEY=change-me
PRODUCT_SERVICE_ACCESS_KEY=change-me
PRODUCT_SERVICE_SECRET_KEY=change-me
ORDER_SERVICE_ACCESS_KEY=change-me
ORDER_SERVICE_SECRET_KEY=change-me
PAYMENT_SERVICE_ACCESS_KEY=change-me
PAYMENT_SERVICE_SECRET_KEY=change-me
