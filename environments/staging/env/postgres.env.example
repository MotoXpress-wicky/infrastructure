# Template. Copy to the same name without .example and fill real values. The real file is ignored by git.
# PostgreSQL admin user (creates the databases on first start)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Read by postgres/init/01-create-databases.sh: one DB user per service.
# Each password must be the SAME as POSTGRES_PASSWORD in that service's env file.
USER_DB_PASSWORD=change-me
PRODUCT_DB_PASSWORD=change-me
ORDER_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me
