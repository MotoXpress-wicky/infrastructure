# Template. Copy to the same name without .example and fill real values. The real file is ignored by git.
SPRING_PROFILES_ACTIVE=docker

# Database (its own database and DB user)
DB_URL=jdbc:postgresql://postgres:5432/payment_db
POSTGRES_USER=payment_service
POSTGRES_PASSWORD=change-me

# RabbitMQ (standard Spring Boot names for spring.rabbitmq.*)
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=change-me
SPRING_RABBITMQ_PASSWORD=change-me

# Must be the same value as JWT_SECRET in user-service.env (it checks the login cookie).
JWT_SECRET=change-me

# Object storage (S3 API) for the courier receipt files (a private bucket).
# Keys = PAYMENT_SERVICE_ACCESS_KEY / PAYMENT_SERVICE_SECRET_KEY in object-storage.env (must match).
# Moving to AWS S3 later: remove S3_ENDPOINT, put AWS keys, the real region and the real bucket name.
S3_ENDPOINT=http://object-storage:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=courier-receipts
