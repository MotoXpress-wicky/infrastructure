# LOCAL ONLY. These values work only on this PC and are safe to commit. Never reuse them on a server.
# One S3 key pair per service (see object-storage/users.conf).
USER_SERVICE_ACCESS_KEY=user-service-local
USER_SERVICE_SECRET_KEY=user-service-local-secret
PRODUCT_SERVICE_ACCESS_KEY=product-service-local
PRODUCT_SERVICE_SECRET_KEY=product-service-local-secret
ORDER_SERVICE_ACCESS_KEY=order-service-local
ORDER_SERVICE_SECRET_KEY=order-service-local-secret
PAYMENT_SERVICE_ACCESS_KEY=payment-service-local
PAYMENT_SERVICE_SECRET_KEY=payment-service-local-secret
