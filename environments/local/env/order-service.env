# LOCAL ONLY. These values work only on this PC and are safe to commit. Never reuse them on a server.
SPRING_PROFILES_ACTIVE=docker

# Database
DB_URL=jdbc:postgresql://postgres:5432/order_db
POSTGRES_USER=order_service
POSTGRES_PASSWORD=order_service_local_pass

# RabbitMQ (standard Spring Boot names for spring.rabbitmq.*)
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=motoxpress
SPRING_RABBITMQ_PASSWORD=rabbitmq_local_pass

# order-service calls product-service. TODO: use the real property name when order-service is built.
# When product-service runs in IntelliJ, use http://host.docker.internal:8081 instead.
PRODUCT_SERVICE_URL=http://product-service:8081

# Object storage (S3 API). TODO: use the real property names when the service is built.
S3_ENDPOINT=http://object-storage:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=order-service-local
S3_SECRET_KEY=order-service-local-secret
S3_BUCKET=shipment-documents
