# LOCAL ONLY. These values work only on this PC and are safe to commit. Never reuse them on a server.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_pass

# One DB user per service (read by postgres/init/01-create-databases.sql)
USER_DB_PASSWORD=user_service_local_pass
PRODUCT_DB_PASSWORD=product_service_local_pass
ORDER_DB_PASSWORD=order_service_local_pass
NOTIFICATION_DB_PASSWORD=notification_service_local_pass
PAYMENT_DB_PASSWORD=payment_service_local_pass
