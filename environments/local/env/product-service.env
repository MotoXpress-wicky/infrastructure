# LOCAL ONLY. These values work only on this PC and are safe to commit. Never reuse them on a server.
SPRING_PROFILES_ACTIVE=docker

# Database
DB_URL=jdbc:postgresql://postgres:5432/product_db
POSTGRES_USER=product_service
POSTGRES_PASSWORD=product_service_local_pass

# Must be the same value as JWT_SECRET in user-service.env (it checks the login cookie).
# TODO: replace with the RS256 public key when user-service signs with RS256 (M17).
JWT_SECRET=local-dev-only-jwt-secret-never-use-on-a-server-0123456789

# Object storage (S3 API) for the part photos.
# Keys = PRODUCT_SERVICE_ACCESS_KEY / PRODUCT_SERVICE_SECRET_KEY in object-storage.env (must match).
S3_ENDPOINT=http://object-storage:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=product-service-local
S3_SECRET_KEY=product-service-local-secret
S3_BUCKET=product-media
# Only the object key is stored. The URL sent to the browser = MEDIA_BASE_URL + "/" + key
MEDIA_BASE_URL=http://localhost/media/products
