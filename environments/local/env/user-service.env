# LOCAL ONLY. These values work only on this PC and are safe to commit. Never reuse them on a server.
SPRING_PROFILES_ACTIVE=docker

# Database
DB_URL=jdbc:postgresql://postgres:5432/user_db
POSTGRES_USER=user_service
POSTGRES_PASSWORD=user_service_local_pass

# RabbitMQ (standard Spring Boot names for spring.rabbitmq.*)
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=motoxpress
SPRING_RABBITMQ_PASSWORD=rabbitmq_local_pass

# Redis (rate limits)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_local_pass

# Signs login tokens. Local-only value, at least 32 characters (until RS256 keys, decision M17).
JWT_SECRET=local-dev-only-jwt-secret-never-use-on-a-server-0123456789

# Cloudflare's official TEST secret key: it accepts every captcha. Local only.
# users-ui must use the matching test site key 1x00000000000000000000AA.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

FRONTEND_URL=http://localhost
FRONTEND_BASE_URL=http://localhost
ALLOWED_ORIGINS=http://localhost,http://admin.localhost

# REAL third-party account. Its real values go in user-service.secrets.env (ignored by git),
# which overrides these lines. Without it, Google login does not work. (user-service sends no email: M44.)
GOOGLE_CLIENT_ID=set-in-user-service.secrets.env
GOOGLE_CLIENT_SECRET=set-in-user-service.secrets.env

# Object storage (S3 API). Profile pictures are planned; use the real property names then.
S3_ENDPOINT=http://object-storage:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=user-service-local
S3_SECRET_KEY=user-service-local-secret
S3_BUCKET=user-avatars
MEDIA_BASE_URL=http://localhost/media/avatars

# The first admin (user-service AdminBootstrap). At start-up, if no admin exists, this account is created
# (or, if it exists, promoted). Log in to http://admin.localhost with it. LOCAL ONLY: never reuse on a server.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=LocalAdmin-2026
ADMIN_BOOTSTRAP_NAME=Local Admin
