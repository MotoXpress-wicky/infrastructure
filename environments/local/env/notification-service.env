# LOCAL ONLY. These values work only on this PC and are safe to commit. Never reuse them on a server.
SPRING_PROFILES_ACTIVE=docker

# Database
DB_URL=jdbc:postgresql://postgres:5432/notification_db
POSTGRES_USER=notification_service
POSTGRES_PASSWORD=notification_service_local_pass

# RabbitMQ (standard Spring Boot names for spring.rabbitmq.*)
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=motoxpress
SPRING_RABBITMQ_PASSWORD=rabbitmq_local_pass

# Must be the same value as JWT_SECRET in user-service.env (it checks the login cookie).
# TODO: replace with the RS256 public key when user-service signs with RS256 (M17).
JWT_SECRET=local-dev-only-jwt-secret-never-use-on-a-server-0123456789

# Email goes to Mailpit (a fake inbox: http://mail.localhost). Standard Spring Boot names for spring.mail.*
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025

# Push through Firebase. Keep false until the key file env/firebase.json exists (a real secret, ignored by git).
# While false, push messages are only written to the log.
NOTIFICATION_PUSH_ENABLED=false
